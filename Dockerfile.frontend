FROM node:24-alpine

WORKDIR /app

COPY frontend/package*.json frontend/
RUN cd frontend && npm ci

COPY frontend frontend
COPY scripts scripts

ENV NEXT_PUBLIC_API_BASE_URL=https://backend:8000 \
    NEXT_DEV_HOST=0.0.0.0 \
    NEXT_DEV_PORT=3000 \
    SKIP_NPM_INSTALL=1

EXPOSE 3000

CMD ["/app/scripts/start-frontend.sh"]
