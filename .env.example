# Development template only. Production requires OIDC, strong secrets, PostgreSQL and reviewed facility evidence.
PHARMSHIFT_ENV=development

# Backend API settings
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
AUDIT_LOG_PATH=logs/audit.log
ACCESS_LOG_PATH=logs/uvicorn_access.log
API_CORS_ALLOW_ORIGINS=https://localhost:3000

# Secrets management (prod: set SECRETS_PROVIDER=aws or vault and omit local values)
SECRETS_PROVIDER=env
SECRETS_CACHE_SECONDS=300
AWS_SECRETS_MANAGER_SECRET_ID=
VAULT_ADDR=
VAULT_SECRET_PATH=
VAULT_NAMESPACE=
VAULT_TOKEN=
VAULT_TIMEOUT_SECONDS=5

# Centralized logging / forwarder
LOG_FORWARDER_BACKEND=stdout
LOG_FORWARDER_BATCH=200
LOG_FORWARDER_INTERVAL=2.0
LOG_JOB_LABEL=pharmshift
LOKI_ENDPOINT=
LOKI_BASE_LABELS=env=dev
LOKI_TENANT_ID=
CLOUDWATCH_LOG_GROUP=
CLOUDWATCH_LOG_STREAM=
AWS_REGION=ap-northeast-1

# Database connection (PostgreSQL)
DATABASE_URL=postgresql+psycopg://pharmshift:pharmshift@localhost:5432/pharmshift
SHIFT_SCHEDULER_DB_URL=postgresql+psycopg://pharmshift:pharmshift@localhost:5432/pharmshift
SHIFT_SCHEDULER_DB_ECHO=false
SHIFT_SCHEDULER_DATA_BACKEND=db

# Frontend → Backend routing
NEXT_PUBLIC_API_BASE_URL=https://localhost:8000
UVICORN_SSL_CERTFILE=./certs/localhost-cert.pem
UVICORN_SSL_KEYFILE=./certs/localhost-key.pem
NEXT_SSL_CERT_PATH=../certs/localhost-cert.pem
NEXT_SSL_KEY_PATH=../certs/localhost-key.pem
SHIFT_SCHEDULER_CONFIG_DIR=./ops/demo_config

# Authentication / tokens (AUTH_MODE=mock 用)
AUTH_MODE=mock
AUTH_JWT_SECRET=change-me
AUTH_TOKEN_TTL_HOURS=8
AUTH_SESSION_COOKIE_NAME=pharmshift_token
AUTH_DISPLAY_NAME_COOKIE=pharmshift_user
AUTH_ROLE_COOKIE=pharmshift_role
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
FRONTEND_BASE_URL=https://localhost:3000
AUTH_PASSWORD_PHARMACIST=pass-ph
AUTH_PASSWORD_LEADER=pass-lead
AUTH_PASSWORD_ADMIN=pass-admin

# OIDC settings (AUTH_MODE=oidc または AZURE_AD_ENABLE=1 の場合に使用)
AZURE_AD_ENABLE=0
OIDC_METADATA_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://localhost:8000/auth/oidc/callback
OIDC_SCOPES=openid profile email offline_access
OIDC_ROLE_CLAIM=roles
OIDC_ROLE_MAPPING_ADMIN=pharmshift-admin
OIDC_ROLE_MAPPING_LEADER=pharmshift-leader
OIDC_ROLE_MAPPING_PHARMACIST=pharmshift-user
OIDC_DEFAULT_ROLE=PHARMACIST
OIDC_USER_ID_CLAIMS=preferred_username,email,oid
OIDC_EMAIL_CLAIMS=email,upn
OIDC_NAME_CLAIMS=name,given_name
OIDC_STATE_COOKIE_NAME=pharmshift_oidc_state
OIDC_STATE_TTL_SECONDS=600
OIDC_JWKS_CACHE_SECONDS=3600
OIDC_HTTP_TIMEOUT_SECONDS=5

# Export CLI defaults (optional secrets-managed overrides)
EXPORTER_BASE_URL=
EXPORTER_USERNAME=
EXPORTER_PASSWORD=

# Independent erasure authority (required in production; see docs/independent-control.md).
# Configure the API, worker and ordinary CLI identically. Never put operator/private
# signing credentials on the ordinary application host.
PHARMSHIFT_CONTROL_URL=
PHARMSHIFT_CONTROL_NODE=
PHARMSHIFT_CONTROL_TOKEN=
PHARMSHIFT_CONTROL_PUBLIC_KEY=
PHARMSHIFT_ERASURE_MANIFEST_KEY=

# Authority service only: separately stored generation witness. Required for a
# production authority. Witness DB/signing keys belong only on the witness host.
# Bootstrap and fail-closed recovery limits: docs/generation-witness.md
PHARMSHIFT_WITNESS_URL=
PHARMSHIFT_WITNESS_CLIENT=
PHARMSHIFT_WITNESS_TOKEN=
PHARMSHIFT_WITNESS_PUBLIC_KEY=
